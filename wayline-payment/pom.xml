<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wayline</groupId>
        <artifactId>wayline-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wayline-payment</artifactId>
    <name>Wayline Payment</name>
    <description>Payment lifecycle management</description>

    <dependencies>
        <dependency>
            <groupId>com.wayline</groupId>
            <artifactId>wayline-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wayline</groupId>
            <artifactId>wayline-routing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wayline</groupId>
            <artifactId>wayline-common</artifactId>
        </dependency>
        <!-- Payments post their financial effect to the ledger inside the same transaction as the
             state change, so the two can never disagree. -->
        <dependency>
            <groupId>com.wayline</groupId>
            <artifactId>wayline-ledger</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
        </dependency>
    </dependencies>
</project>
